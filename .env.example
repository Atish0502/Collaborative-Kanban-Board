# Server configuration
PORT=4000
NODE_ENV=development

# SQLite database path (relative to server working directory or absolute path)
DB_PATH=./data/kanban.db

# CORS origin for frontend dev server (comma-separated or * in dev)
CORS_ORIGIN=http://localhost:5173

# Serve built frontend static files from Express in production
SERVE_CLIENT=false

# Failure injection (disabled by default; enable for optimistic rollback testing)
FAILURE_INJECTION_ENABLED=false
FAILURE_INJECTION_RATE=0
ALLOW_FAILURE_INJECTION_HEADER=true

# SSE heartbeat interval in milliseconds
SSE_HEARTBEAT_MS=25000

# Frontend API base URL (optional; Vite proxies /api to localhost:4000 in dev)
VITE_API_BASE_URL=
